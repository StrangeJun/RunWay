.idea/
**/.idea/
*.iml
*.iws
*.ipr
out/

# ─── Gradle ──────────────────────────────────────────────
.gradle/
build/
**/build/

# ─── Java compiled ───────────────────────────────────────
*.class

# ─── Android ─────────────────────────────────────────────
local.properties
captures/
.externalNativeBuild/
.cxx/

# ─── Environment / Secrets ───────────────────────────────
.env
.env.local
*.env
application-local.yml

