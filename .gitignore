.github/

# ─── Do NOT ignore (Gradle wrapper must be committed) ────
!gradlew
!gradlew.bat
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
!**/gradle/wrapper/gradle-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.properties

# ─── Docs ────────────────────────────────────────────────
